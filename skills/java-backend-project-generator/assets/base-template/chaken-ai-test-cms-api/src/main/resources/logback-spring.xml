<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="java-api"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <!-- Prefer JsonEncoder on Spring Boot 4 / Logback 1.5+. If the company runtime uses another encoder, keep field names stable. -->
    <encoder class="ch.qos.logback.classic.encoder.JsonEncoder"/>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
