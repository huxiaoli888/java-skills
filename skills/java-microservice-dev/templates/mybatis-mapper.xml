<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="{{basePackage}}.mapper.{{mapperClass}}">

  <resultMap id="BaseResultMap" type="{{basePackage}}.entity.{{entityClass}}">
    <id column="id" property="id"/>
  </resultMap>

  <select id="selectById" resultMap="BaseResultMap">
    select *
    from {{tableName}}
    where id = #{id}
  </select>

  <insert id="insert" parameterType="{{basePackage}}.entity.{{entityClass}}">
    insert into {{tableName}} (
      id
    ) values (
      #{id}
    )
  </insert>

  <update id="updateById" parameterType="{{basePackage}}.entity.{{entityClass}}">
    update {{tableName}}
    set id = #{id}
    where id = #{id}
  </update>
</mapper>
